{
  "doctype": "DocType",
  "name": "ASOUD Company Setup",
  "module": "ASOUD ERP",
  "autoname": "field:company",
  "title_field": "company",
  "track_changes": 1,
  "field_order": [
    "company", "office_type", "national_id", "economic_code",
    "owner_full_name", "registration_number", "activity_type", "company_type",
    "parent_office", "phone", "email", "website", "province", "city",
    "address", "postal_code", "description", "office_saved",
    "accounting_basis", "display_currency", "fiscal_year_start_day", "fiscal_year_start_month", "fiscal_year", "chart_template",
    "auto_generate_detail_code", "accounting_saved", "enabled_roles_json", "roles_saved"
  ],
  "fields": [
    {"fieldname": "company", "label": "Company", "fieldtype": "Link", "options": "Company", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "office_type", "label": "Office Type", "fieldtype": "Select", "options": "Personal\nLegal", "reqd": 1},
    {"fieldname": "national_id", "label": "National ID", "fieldtype": "Data"},
    {"fieldname": "economic_code", "label": "Economic Code", "fieldtype": "Data"},
    {"fieldname": "owner_full_name", "label": "Owner Full Name", "fieldtype": "Data"},
    {"fieldname": "registration_number", "label": "Registration Number", "fieldtype": "Data"},
    {"fieldname": "activity_type", "label": "Activity Type", "fieldtype": "Data", "default": "Commercial"},
    {"fieldname": "company_type", "label": "Company Type", "fieldtype": "Data"},
    {"fieldname": "parent_office", "label": "Parent Office", "fieldtype": "Data"},
    {"fieldname": "phone", "label": "Phone", "fieldtype": "Data"},
    {"fieldname": "email", "label": "Email", "fieldtype": "Data", "options": "Email"},
    {"fieldname": "website", "label": "Website", "fieldtype": "Data"},
    {"fieldname": "province", "label": "Province", "fieldtype": "Data", "default": "Tehran"},
    {"fieldname": "city", "label": "City", "fieldtype": "Data", "default": "Tehran"},
    {"fieldname": "address", "label": "Address", "fieldtype": "Small Text"},
    {"fieldname": "postal_code", "label": "Postal Code", "fieldtype": "Data"},
    {"fieldname": "fiscal_year", "label": "Fiscal Year", "fieldtype": "Data", "default": "1405"},
    {"fieldname": "description", "label": "Description", "fieldtype": "Small Text"},
    {"fieldname": "office_saved", "label": "Office Saved", "fieldtype": "Check", "default": "0", "read_only": 1},
    {"fieldname": "accounting_basis", "label": "Accounting Basis", "fieldtype": "Data", "default": "Accrual", "read_only": 1},
    {"fieldname": "display_currency", "label": "Display Currency", "fieldtype": "Select", "options": "Rial\nToman", "default": "Rial"},
    {"fieldname": "fiscal_year_start_day", "label": "Fiscal Year Start Day", "fieldtype": "Int", "default": "1"},
    {"fieldname": "fiscal_year_start_month", "label": "Fiscal Year Start Month", "fieldtype": "Int", "default": "1"},
    {"fieldname": "chart_template", "label": "Chart Template", "fieldtype": "Select", "options": "Iran Standard\nService\nCommercial\nManufacturing", "default": "Iran Standard"},
    {"fieldname": "auto_generate_detail_code", "label": "Auto Generate Detail Code", "fieldtype": "Check", "default": "1"},
    {"fieldname": "accounting_saved", "label": "Accounting Saved", "fieldtype": "Check", "default": "0", "read_only": 1},
    {"fieldname": "enabled_roles_json", "label": "Enabled Office Roles JSON", "fieldtype": "Long Text", "default": "[\"System Manager\"]", "read_only": 1},
    {"fieldname": "roles_saved", "label": "Roles Saved", "fieldtype": "Check", "default": "0", "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Accounts Manager", "read": 1, "write": 1, "create": 1},
    {"role": "Accounts User", "read": 1}
  ]
}
