{
  "doctype":"DocType","name":"ASOUD Internal Communication","module":"ASOUD ERP","autoname":"format:HR-COM-{YYYY}-{#####}","track_changes":1,
  "field_order":["company","sender","communication_type","subject","content","priority","confidential","due_date","status","recipients"],
  "fields":[
