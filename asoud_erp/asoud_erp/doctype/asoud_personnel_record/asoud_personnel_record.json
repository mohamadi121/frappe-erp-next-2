{
  "doctype": "DocType",
  "name": "ASOUD Personnel Record",
  "module": "ASOUD ERP",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "company",
    "party",
    "kind",
    "title",
    "record_date",
    "payload",
    "request_id",
    "native_doctype",
    "native_name",
    "native_secondary",
    "notes",
    "request_fingerprint",
    "document_category",
    "document_number",
    "expiry_date"
  ],
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "party",
      "label": "Person",
      "fieldtype": "Link",
      "options": "ASOUD Party Profile",
      "reqd": 1
    },
    {
      "fieldname": "kind",
      "label": "Kind",
      "fieldtype": "Select",
      "options": "attendance\nevaluation\ndocument\nphoto\nhistory",
      "reqd": 1
    },
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "record_date",
      "label": "Date",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "payload",
      "label": "Private payload",
      "fieldtype": "Long Text",
      "reqd": 1
    },
    {
      "fieldname": "request_id",
      "label": "Request ID",
      "fieldtype": "Data",
      "unique": 1,
      "reqd": 1
    },
    {
      "fieldname": "native_doctype",
      "label": "Native DocType",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "DocType"
    },
    {
      "fieldname": "native_name",
      "label": "Native Document",
      "fieldtype": "Dynamic Link",
      "read_only": 1,
      "options": "native_doctype"
    },
    {
      "fieldname": "native_secondary",
      "label": "Departure Checkin",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Employee Checkin"
    },
    {
      "fieldname": "notes",
      "label": "Display Notes",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "request_fingerprint",
      "label": "Request Fingerprint",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "document_category",
      "label": "Document Category",
      "fieldtype": "Select",
      "options": "\nIdentity\nEducation\nEmployment\nMedical\nFinancial\nOther"
    },
    {
      "fieldname": "document_number",
      "label": "Document Number",
      "fieldtype": "Data"
    },
    {
      "fieldname": "expiry_date",
      "label": "Expiry Date",
      "fieldtype": "Date"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
