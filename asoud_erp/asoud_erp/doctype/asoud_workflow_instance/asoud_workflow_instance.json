{
  "doctype": "DocType",
  "name": "ASOUD Workflow Instance",
  "module": "ASOUD ERP",
  "autoname": "format:WFI-{YYYY}-{#####}",
  "title_field": "subject",
  "track_changes": 1,
  "field_order": ["workflow_definition", "subject", "reference_doctype", "reference_name", "status", "current_stage", "started_by", "started_on", "completed_on"],
  "fields": [
    {"fieldname": "workflow_definition", "label": "Workflow Definition", "fieldtype": "Link", "options": "ASOUD Workflow Definition", "reqd": 1, "in_list_view": 1},
    {"fieldname": "subject", "label": "Subject", "fieldtype": "Data", "reqd": 1, "in_list_view": 1},
    {"fieldname": "reference_doctype", "label": "Reference DocType", "fieldtype": "Link", "options": "DocType"},
    {"fieldname": "reference_name", "label": "Reference Name", "fieldtype": "Dynamic Link", "options": "reference_doctype"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Running\nCompleted\nRejected\nCancelled\nFailed", "default": "Running", "reqd": 1, "in_list_view": 1},
    {"fieldname": "current_stage", "label": "Current Stage", "fieldtype": "Link", "options": "ASOUD Workflow Stage"},
    {"fieldname": "started_by", "label": "Started By", "fieldtype": "Link", "options": "User", "read_only": 1},
    {"fieldname": "started_on", "label": "Started On", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "completed_on", "label": "Completed On", "fieldtype": "Datetime", "read_only": 1}
  ],
  "permissions": [
    {"role": "System Manager", "create": 1, "read": 1, "write": 1, "delete": 1},
    {"role": "Accounts Manager", "create": 1, "read": 1, "write": 1},
    {"role": "Accounts User", "create": 1, "read": 1}
  ]
}
