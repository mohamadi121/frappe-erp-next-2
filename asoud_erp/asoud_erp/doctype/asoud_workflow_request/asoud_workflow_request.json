{
  "doctype": "DocType",
  "name": "ASOUD Workflow Request",
  "module": "ASOUD ERP",
  "autoname": "format:REQ-{#####}",
  "track_changes": 1,
  "field_order": [
    "company",
    "workflow_definition",
    "request_type",
    "subject",
    "priority",
    "required_by",
    "project",
    "department",
    "values_json",
    "attachments_json",
    "workflow_instance",
    "status",
    "display_status",
    "request_id",
    "request_fingerprint",
    "template_key",
    "template_version",
    "requester_employee",
    "status_key",
    "search_text",
    "native_doctype",
    "native_name",
    "native_status",
    "native_error"
  ],
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "workflow_definition",
      "label": "Workflow",
      "fieldtype": "Link",
      "options": "ASOUD Workflow Definition",
      "reqd": 1
    },
    {
      "fieldname": "request_type",
      "label": "Request Type",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "subject",
      "label": "Subject",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nNormal\nHigh\nUrgent",
      "default": "Normal"
    },
    {
      "fieldname": "required_by",
      "label": "Required By",
      "fieldtype": "Date"
    },
    {
      "fieldname": "project",
      "label": "Project",
      "fieldtype": "Data"
    },
    {
      "fieldname": "department",
      "label": "Department",
      "fieldtype": "Data"
    },
    {
      "fieldname": "values_json",
      "label": "Dynamic Values",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "attachments_json",
      "label": "Attachments",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "workflow_instance",
      "label": "Workflow Instance",
      "fieldtype": "Link",
      "options": "ASOUD Workflow Instance"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nCompleted\nRejected\nCancelled",
      "default": "Draft",
      "reqd": 1
    },
    {
      "fieldname": "display_status",
      "label": "Display Status",
      "fieldtype": "Data",
      "read_only": 1,
      "description": "Label set by a workflow Change Status action; presentation only."
    },
    {
      "fieldname": "request_id",
      "label": "request_id",
      "fieldtype": "Data",
      "read_only": 1,
      "unique": 1
    },
    {
      "fieldname": "request_fingerprint",
      "label": "request_fingerprint",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "template_key",
      "label": "Template Key",
      "fieldtype": "Data",
      "read_only": 1,
      "search_index": 1,
      "description": "Copied from the request type at creation; empty for custom request types."
    },
    {
      "fieldname": "template_version",
      "label": "Template Version",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "requester_employee",
      "label": "Requester Employee",
      "fieldtype": "Link",
      "options": "Employee",
      "read_only": 1
    },
    {
      "fieldname": "status_key",
      "label": "Status Key",
      "fieldtype": "Data",
      "read_only": 1,
      "search_index": 1,
      "description": "Mirrored from the workflow instance by the lifecycle hook."
    },
    {
      "fieldname": "search_text",
      "label": "Search Text",
      "fieldtype": "Small Text",
      "read_only": 1,
      "description": "Denormalized text used by the request list search."
    },
    {
      "fieldname": "native_doctype",
      "label": "Native DocType",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "native_name",
      "label": "Native Document",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "native_status",
      "label": "Native Document Status",
      "fieldtype": "Select",
      "options": "\nPending\nCreated\nSkipped\nFailed",
      "read_only": 1
    },
    {
      "fieldname": "native_error",
      "label": "Native Document Error",
      "fieldtype": "Small Text",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1
    },
    {
      "role": "HR Manager",
      "read": 1
    },
    {
      "role": "Employee",
      "read": 1
    },
    {
      "role": "Accounts User",
      "read": 1
    },
    {
      "role": "Accounts Manager",
      "read": 1
    }
  ]
}
